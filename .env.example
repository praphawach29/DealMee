# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ───────────────────────────────────────────────────────────
# Encrypts the API keys saved on /admin/system-settings (any long random string).
# Never change it once keys are saved there, or they can no longer be read.
SETTINGS_ENCRYPTION_KEY=

# AI / slip / RapidAPI keys can also be set on /admin/system-settings, which wins over these
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Knowledge embeddings (pgvector, 768 dimensions). Prefer Gemini.
# Uses GEMINI_API_KEY above. Optional model override:
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna          # fast/cheap tier — this provider is only used as the final fallback

# ── Slip Verification ──────────────────────────────────────────────────────
EASYSLIP_API_KEY=

# ── Billing (Phase 2) ──────────────────────────────────────────────────────
# Stripe: global card recurring subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Omise/Opn Payments: Thai PromptPay one-time charges (no native recurring —
# webhook status is always re-verified via the Omise API, not signature-checked)
OMISE_SECRET_KEY=

# Public app URL — used for Stripe Checkout success/cancel redirects and the
# billing portal return URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC secret for customer quotation accept links (/doc/quotation/:id?accept=...).
# Any long random string. Rotating it invalidates links already sent to customers.
# Required in Vercel or the accept button rejects every confirmation.
DOC_ACCEPT_SECRET=
# Per-shop AI skills telemetry stays off unless both this flag and
# shops.features.shop_skills_enabled are true.
SHOP_SKILLS_TELEMETRY_ENABLED=true
SHOP_SKILLS_RETRIEVAL_ENABLED=true

# ── Nightly skill review (Vercel Cron) ─────────────────────────────────────
# Shared with /api/cron/follow-up. Vercel sends Authorization: Bearer <CRON_SECRET>.
# Schedule is 18:00 UTC (01:00 Asia/Bangkok) via vercel.json. Set to 0 to no-op.
CRON_SECRET=
# SKILL_REVIEW_ENABLED=0
